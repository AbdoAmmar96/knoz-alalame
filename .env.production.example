# ==========================================================
#  إعدادات الإنتاج — انسخه إلى .env على السيرفر ثم عدّل القيم
#  لا ترفع هذا الملف مملوءاً ببيانات حقيقية إلى أي مستودع
# ==========================================================

APP_NAME="كنوز العالم للمصاعد"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://konozcompany.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Riyadh

# ---------- قاعدة البيانات ----------
# SQLite (الأبسط — يكفي لموقع بهذا الحجم):
#   DB_CONNECTION=sqlite   ثم أنشئ database/database.sqlite
# MySQL (الأشيع على الاستضافات المشتركة):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=konoz
DB_USERNAME=
DB_PASSWORD=

# ---------- الجلسة والكاش ----------
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------- السجلّات ----------
LOG_CHANNEL=daily
LOG_LEVEL=error

# ---------- البريد (اختياري: لإشعار الطلبات الجديدة) ----------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@konozcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
